#!/bin/sh
set -eu

STATE_ROOT="State:/Network/awsvpn"
DNS_SERVICE_KEY="com.amazonaws.acvc"
DEFAULT_DOMAIN="${AWSVPN_DEFAULT_DOMAIN:-openvpn}"

log() {
  printf '%s\n' "awsvpn client.up: $*" >&2
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    log "missing required command: $1"
    exit 1
  fi
}

flush_dns_cache() {
  if [ -x /usr/bin/dscacheutil ]; then
    /usr/bin/dscacheutil -flushcache >/dev/null 2>&1 || true
  fi

  if [ -x /usr/bin/killall ]; then
    /usr/bin/killall -HUP mDNSResponder >/dev/null 2>&1 || true
    /usr/bin/killall -HUP mDNSResponderHelper >/dev/null 2>&1 || true
  fi
}

add_unique_word() {
  list="$1"
  word="$2"

  case " $list " in
    *" $word "*) printf '%s' "$list" ;;
    *) printf '%s' "${list:+$list }$word" ;;
  esac
}

is_valid_dns_server() {
  case "$1" in
    ""|*[!0123456789abcdefABCDEF:.]*) return 1 ;;
    *) return 0 ;;
  esac
}

is_valid_domain() {
  domain="$1"
  [ -n "$domain" ] || return 1
  [ "${#domain}" -le 253 ] || return 1
  case "$domain" in
    .*|*.|*..*|-*|*-) return 1 ;;
    *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-]*) return 1 ;;
  esac

  old_ifs="$IFS"
  IFS=.
  for label in $domain; do
    [ -n "$label" ] || return 1
    [ "${#label}" -le 63 ] || return 1
    case "$label" in
      -*|*-) return 1 ;;
    esac
  done
  IFS="$old_ifs"
  return 0
}

validate_dns_servers() {
  for server in $dns_servers; do
    if ! is_valid_dns_server "$server"; then
      log "invalid pushed DNS server; refusing to modify DNS"
      exit 1
    fi
  done
}

validate_search_domains() {
  for domain in $search_domains; do
    if ! is_valid_domain "$domain"; then
      log "invalid DNS search domain; refusing to modify DNS"
      exit 1
    fi
  done
}

collect_openvpn_dns_options() {
  dns_servers=""
  search_domains=""
  domain_name=""

  index=1
  while [ "$index" -le 255 ]; do
    eval "option=\${foreign_option_${index}:-}"
    [ -z "$option" ] && {
      index=$((index + 1))
      continue
    }

    case "$option" in
      "dhcp-option DNS "*)
        value="${option#dhcp-option DNS }"
        dns_servers="$(add_unique_word "$dns_servers" "$value")"
        ;;
      "dhcp-option DOMAIN "*)
        domain_name="${option#dhcp-option DOMAIN }"
        ;;
      "dhcp-option DOMAIN-SEARCH "*)
        value="${option#dhcp-option DOMAIN-SEARCH }"
        search_domains="$(add_unique_word "$search_domains" "$value")"
        ;;
      "dhcp-option SEARCH-DOMAIN "*)
        value="${option#dhcp-option SEARCH-DOMAIN }"
        search_domains="$(add_unique_word "$search_domains" "$value")"
        ;;
    esac

    index=$((index + 1))
  done

  [ -n "$dns_servers" ] || return 1

  if [ -z "$domain_name" ]; then
    domain_name="$DEFAULT_DOMAIN"
  fi

  if [ -z "$search_domains" ]; then
    search_domains="$domain_name"
  fi

  for value in ${AWSVPN_SEARCH_DOMAINS:-}; do
    search_domains="$(add_unique_word "$search_domains" "$value")"
  done

  validate_dns_servers
  validate_search_domains

  export dns_servers search_domains domain_name
}

apply_dns() {
  /usr/sbin/scutil <<EOF >/dev/null
remove State:/Network/Service/$DNS_SERVICE_KEY/DNS
remove $STATE_ROOT
d.init
d.add ServerAddresses * $dns_servers
d.add SupplementalMatchDomains * $search_domains
set State:/Network/Service/$DNS_SERVICE_KEY/DNS
d.init
d.add Active 1
set $STATE_ROOT
EOF
}

require_command /usr/sbin/scutil

if ! collect_openvpn_dns_options; then
  log "no pushed DNS options found; leaving DNS unchanged"
  exit 0
fi

apply_dns
flush_dns_cache

log "configured scoped DNS servers [$dns_servers] for domains [$search_domains]"
